{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Llm": {
    "Provider": "Stub",
    "Pricing": {
      "Models": {
        "gemini-3.5-flash-lite": { "InputPerMillionUsd": 0.30, "OutputPerMillionUsd": 2.50 },
        "gemini-2.0-flash": { "InputPerMillionUsd": 0.10, "OutputPerMillionUsd": 0.40 },
        "stub": { "InputPerMillionUsd": 0, "OutputPerMillionUsd": 0 }
      }
    },
    "Stub": {
      "ScriptPath": "stub/stub-scripts.json"
    }
  },
  "Ask": {
    "RequestDeadline": "00:01:00",
    "LlmTimeout": "00:00:30",
    "CommandTimeout": "00:00:15",
    "RowLimit": 1000,
    "HistoryTurns": 10,
    "MaxExplanationLength": 500
  },
  "Conversations": {
    "Ttl": "01:00:00",
    "SweepInterval": "00:01:00"
  }
}

