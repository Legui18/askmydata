# Copy to .env and fill in. .env is git-ignored.
# SQL Server complexity rules: 8+ chars, upper, lower, digit and symbol.
# Avoid quotes, $ and ; in passwords (they are embedded in a connection string and sqlcmd -v).
SA_PASSWORD=<your-strong-sa-password>
READONLY_PASSWORD=<your-strong-reader-password>
# Only used when Llm__Provider is switched from Stub to Gemini.
GEMINI_API_KEY=<your-gemini-api-key>
